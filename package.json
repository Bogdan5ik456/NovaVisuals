{
  "name": "nova-visuals-launcher",
  "productName": "Nova Visuals",
  "version": "1.0.2",
  "description": "Nova Visuals — власний Minecraft Java Launcher",
  "main": "main.js",
  "author": "Nova Visuals",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.novavisuals.launcher",
    "productName": "Nova Visuals",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Visuals",
      "uninstallDisplayName": "Nova Visuals",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "artifactName": "NovaVisuals-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "mod-dist",
        "to": "mod"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Bogdan5ik456",
        "repo": "NovaVisuals"
      }
    ]
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.0",
    "msmc": "^5.0.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.0"
  }
}